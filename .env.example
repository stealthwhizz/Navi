# Optional AI review. Keep your real .env local; it is ignored by Git.
GROQ_API_KEY=
# Optional compatibility provider: select --ai-provider openai explicitly.
OPENAI_API_KEY=

# Workspace access and PostgreSQL history are optional for local CLI scans.
# Set NAVI_API_TOKEN to a random value of at least 32 characters when serving.
# NAVI_API_TOKEN=
# DATABASE_URL=postgresql://navi:YOUR_PASSWORD@127.0.0.1:5432/navi

# Shared key for optional Laravel operation tracing (at least 32 bytes).
# NAVI_TRACE_KEY=

# Docker Compose also needs these project-specific values:
# NAVI_SOURCE_DIR=/absolute/path/to/application
# NAVI_SCAN_CONFIG=/absolute/path/to/scan.json
# NAVI_TARGET=http://your-application:8000
# NAVI_PROJECT_KEY=your-project
# POSTGRES_PASSWORD=YOUR_URL_SAFE_PASSWORD
