# Copy to .env and set a non-empty local-only PostgreSQL password.
POSTGRES_USER=cyberforge
POSTGRES_PASSWORD=
POSTGRES_DB=cyberforge

# Existing PHP source tree to scan; set this path before starting Compose.
CYBERFORGE_SOURCE_PATH=
# DVWA on the host from inside Docker; change the port/origin to the explicit local target.
CYBERFORGE_ALLOWED_TARGET_ORIGIN=http://host.docker.internal:4280
CYBERFORGE_API_PORT=8000
